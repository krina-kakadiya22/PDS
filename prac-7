import mysql.connector

# Connect to MySQL
con = mysql.connector.connect(
    host="localhost",
    user="root",
    password="your_password",
    database="college"
)

cursor = con.cursor()

# CREATE
cursor.execute(
    "INSERT INTO students (id, name, marks) VALUES (%s, %s, %s)",
    (5, "Asha", 82)
)
con.commit()
print("1. Record created")

# READ
cursor.execute("SELECT * FROM students")

print("\n2. Student Records:")
for row in cursor.fetchall():
    print(row)

# UPDATE
cursor.execute(
    "UPDATE students SET marks=%s WHERE id=%s",
    (92, 5)
)
con.commit()
print("\n3. Record updated")

# DELETE
cursor.execute(
    "DELETE FROM students WHERE id=%s",
    (5,)
)
con.commit()
print("4. Record deleted")

cursor.close()
con.close()
